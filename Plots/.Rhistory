p_accuracy <- make_metric_plot(
"accuracy",
"Collective accuracy\n",
ylim = c(0, 1),
hide_x = TRUE
)
p_hacc <- make_metric_plot(
"human_accuracy",
"Counterfactual\ncollective accuracy",
hide_x = TRUE
)
p_belief <- make_metric_plot(
"median_AI_belief",
"Median reliance on AI\n",
ylim = c(0, 1),
hide_x = TRUE
)
p_var <- make_metric_plot(
"variance",
"Collective variance",
ylim = c(0, 750)
) +
labs(x = NULL)
p_bias <- make_metric_plot(
"bias_sq",
"Collective bias",
ylim = c(0, 800)
)
p_div <- make_metric_plot(
"interest_diversity",
"Interest Diversity",
ylim = c(0, 51)
) +
labs(x = NULL)
p_combined <- (
p_accuracy | p_hacc | p_belief
) / (
p_var | p_bias | p_div
) +
plot_layout(
guides = "collect",
axis_titles = "collect_x"
) &
theme(
legend.position = "right"
)
ggsave(
here("Figures", "Supplementary figure 6.pdf"),
p_combined,
width = 13,
height = 8,
units = "in",
device = grDevices::cairo_pdf,
bg = "white"
)
