y_label
) {
ggplot(
data,
aes(x = V1, y = V3)
) +
geom_point(
size = 2.4,
color = incentive_colors[incentive],
alpha = 0.3
) +
geom_hline(
yintercept = median_reliance,
linetype = "dashed",
linewidth = 2,
color = "black"
) +
scale_x_continuous(
limits = c(0, 50),
breaks = c(0, 25, 50),
expand = expansion(add = 1.5)
) +
scale_y_continuous(
limits = c(0, 1),
breaks = c(0, 0.5, 1),
labels = c("0.0", "0.5", "1.0"),
expand = expansion(add = 0.04)
) +
labs(
x = "Interest",
y = y_label
) +
scatter_theme
}
