)
belief_balanced <- make_belief_plot(
balanced_players,
"Balanced",
NULL
)
reliance_feedback <- make_reliance_plot(
feedback_players,
"Feedback",
median_reliance_feedback,
"Reliance on AI"
)
reliance_niche <- make_reliance_plot(
niche_players,
