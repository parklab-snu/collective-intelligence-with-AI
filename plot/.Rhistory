library(tidyverse)
files <- c(
"Test 1" = "C:\Users\glaucous_winged_gull\Desktop\Climate_and_urbanisation_shape_global_plumage_polymorphsim_in_feral_pigeons\Data\Test_1.csv",
library(tidyverse)
files <- c(
"Test 1" = "C:\Users\glaucous_winged_gull\Desktop\Climate_and_urbanisation_shape_global_plumage_polymorphsim_in_feral_pigeons\Data\Test_1.csv",
files <- c(
"Test 1" = "C:/Users/glaucous_winged_gull/Desktop/Climate_and_urbanisation_shape_global_plumage_polymorphsim_in_feral_pigeons/Data/Test_1.csv",
"Test 2" = "C:/Users/glaucous_winged_gull/Desktop/Climate_and_urbanisation_shape_global_plumage_polymorphsim_in_feral_pigeons/Data/Test_2.csv",
"Test 3" = "C:/Users/glaucous_winged_gull/Desktop/Climate_and_urbanisation_shape_global_plumage_polymorphsim_in_feral_pigeons/Data/Test_3.csv",
"Test 4" = "C:/Users/glaucous_winged_gull/Desktop/Climate_and_urbanisation_shape_global_plumage_polymorphsim_in_feral_pigeons/Data/Test_4.csv"
)
make_pair <- function(lit, citizen, morph_cols, source) {
lit_values <- as.character(unlist(lit[morph_cols], use.names = FALSE))
citizen_values <- as.numeric(unlist(citizen[morph_cols], use.names = FALSE))
groups <- list()
labels <- character()
k <- 0
for (i in seq_along(morph_cols)) {
if (lit_values[i] == ".") {
groups[[k]] <- c(groups[[k]], i)
labels[k] <- paste(labels[k], morph_cols[i], sep = " + ")
} else {
k <- k + 1
groups[[k]] <- i
labels[k] <- morph_cols[i]
}
}
tibble(
Source = source,
City = as.character(lit$City),
Morph = labels,
Census = map_dbl(groups, \(x) as.numeric(lit_values[x[1]])),
Citizen = map_dbl(groups, \(x) sum(citizen_values[x]))
)
}
read_source <- function(path, source) {
dat <- read_csv(
path,
na = c("", "NA"),
show_col_types = FALSE
)
morph_cols <- setdiff(
names(dat),
c("City", "Sum", "Support")
)
literature_rows <- which(!is.na(dat$City))
map_dfr(literature_rows, function(i) {
citizen_row <- which(
seq_len(nrow(dat)) > i & is.na(dat$City)
)[1]
make_pair(
dat[i, ],
dat[citizen_row, ],
morph_cols,
source
)
})
}
plot_data <- imap_dfr(
files,
\(path, source) read_source(path, source)
)
ggplot(
plot_data,
aes(x = Census, y = Citizen, color = Source)
) +
geom_abline(
intercept = 0,
slope = 1,
linetype = "dashed",
linewidth = 0.7,
color = "grey40"
) +
geom_point(
size = 2.7,
alpha = 0.8
) +
scale_color_brewer(palette = "Dark2") +
scale_x_continuous(
limits = c(0, 80),
breaks = seq(0, 80, 20)
) +
scale_y_continuous(
limits = c(0, 80),
breaks = seq(0, 80, 20)
) +
coord_equal() +
labs(
x = "Morph frequency in systematic surveys (%)",
y = "Morph frequency in citizen-science data (%)",
color = "Data source"
) +
theme_classic(base_size = 12) +
theme(
legend.position = "right"
)
ggsave(
"Supplementary_1to1_plot.pdf",
width = 5.5,
height = 5,
units = "in"
)
